# DevProof AI — backend environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── FastAPI ────────────────────────────────────────────────────────────────
# Allowed CORS origins (comma-separated). Default covers local Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── LLM Provider ──────────────────────────────────────────────────────────
# Set to 'mock' for offline development (no API key required).
# Other values added in ST-2: watsonx | openai
LLM_PROVIDER=mock
LLM_MODEL=ibm/granite-13b-chat-v2
